# Mijote : copier en .env (Docker) ou .env.local (développement). Tout est facultatif.

# ─── Accès ───
# Mot de passe de l'appli (fortement conseillé si elle est joignable depuis Internet).
# Vide = pas de mot de passe (réseau local, VPN, ou un proxy qui protège déjà l'accès).
MIJOTE_PASSWORD=
# Adresse publique (sert au code d'installation du Raccourci Apple Santé). Vide = l'adresse de la page.
MIJOTE_PUBLIC_URL=
# Port publié par docker compose (défaut 3010).
MIJOTE_PORT=3010

# ─── IA (facultatif) ───
# Clé de l'API Claude (https://console.anthropic.com). Sans clé : tout marche, sauf les boutons IA
# (atelier de recettes, coach, programme de sport sur mesure, dessins d'aliments).
ANTHROPIC_API_KEY=
# Plafond de dépense IA par mois, en dollars : au-delà, les boutons IA s'arrêtent jusqu'au mois suivant.
AI_MONTHLY_CAP_USD=10
# Imports de recettes par jour (texte collé mis au format par l'IA). 0 coupe l'import.
AI_IMPORTS_PER_DAY=10
# Développement seulement : faux client IA (réponses simulées, aucun appel). Ignoré en production.
# MIJOTE_AI_MOCK=1

# ─── Catalogue de produits (facultatif, avancé) ───
# Une API compatible chronocatalog (voir docs/catalogue.md) : produits, prix et stocks d'un drive.
# Vide = la liste de courses donne les quantités par rayon, sans prix.
CHRONOCATALOG_URL=
CHRONOCATALOG_ACCOUNT_TOKEN=

# ─── Données ───
# Dossier de la base SQLite (défaut : ./data en développement, /data dans Docker).
MIJOTE_DATA_DIR=
