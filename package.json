{
  "name": "mijote",
  "version": "2.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "import:recipes": "tsx --env-file-if-exists=.env.local scripts/import-recipes.ts",
    "test": "tsx --test tests/*.test.ts",
    "list:demo": "tsx --env-file-if-exists=.env.local scripts/list-demo.ts",
    "shortcut:build": "tsx scripts/shortcut.ts",
    "illus:coverage": "tsx scripts/illus-coverage.ts",
    "plan:audit": "tsx scripts/plan-audit.ts",
    "docker:up": "docker compose up -d --build",
    "test:ai": "tsx --env-file-if-exists=.env.local scripts/ai-check.ts",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "description": "Batch cooking planifié, liste de courses, nutrition juste et sport à la maison, pour tout le foyer. L'IA propose, le code vérifie.",
  "license": "MIT"
}
